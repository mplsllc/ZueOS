---
componentName: xueos

windowExpanding:    fullscreen

strings:
    productName:         XueOS
    shortProductName:    XueOS
    version:             24.04
    shortVersion:        noble
    versionedName:       XueOS 24.04
    shortVersionedName:  XueOS 24.04
    bootloaderEntryName: XueOS
    productUrl:          https://xueos.mp.ls/
    supportUrl:          https://xueos.mp.ls/

images:
    productLogo:         "logo.png"
    productIcon:         "icon.png"
    productWelcome:      "welcome.png"

slideshow:               "show.qml"

slideshowAPI:            1

style:
   # Softer than the original near-black olive + neon-yellow highlight:
   # a mid-tone warm olive-gold (sampled from the logo's own lighter
   # wordmark fill) instead of near-black, and a muted gold instead of
   # the harsher cheese-yellow for the current-step highlight.
   SidebarBackground:    "#786721"
   SidebarText:          "#f5eecb"
   SidebarTextCurrent:   "#e6c229"
