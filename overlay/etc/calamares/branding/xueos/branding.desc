---
componentName: xueos

windowExpanding:    fullscreen

strings:
    productName:         XueOS
    shortProductName:    XueOS
    version:             24.04
    shortVersion:        noble
    versionedName:       XueOS 24.04
    shortVersionedName:  XueOS 24.04
    bootloaderEntryName: XueOS
    productUrl:          https://xueos.mp.ls/
    supportUrl:          https://xueos.mp.ls/

images:
    productLogo:         "logo.png"
    productIcon:         "icon.png"
    productWelcome:      "welcome.png"

slideshow:               "show.qml"

slideshowAPI:            1

style:
   # Off the brown/gold/olive family entirely per feedback — the mascot
   # art itself stays warm-toned (that's its actual character design,
   # not something a palette swap here can change), but the UI chrome
   # doesn't need to match it. Cool neutral slate-blue instead.
   SidebarBackground:    "#3e4c5c"
   SidebarText:          "#eef2f5"
   SidebarTextCurrent:   "#7ec8e3"
